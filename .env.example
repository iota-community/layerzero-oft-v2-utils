##### Sepolia EVM (source chain) <--> IOTA MoveVM testnet (destination chain) #####

DEPLOYER_ACCOUNT_PRIV_KEY="put here your own private key"

# Config for Sepolia EVM (src chain)
# https://docs.layerzero.network/v2/developers/evm/technical-reference/deployed-contracts
lzEndpointOnSrcChain=0x6EDCE65403992e310A62460808c4b910D972f10f
lzEndpointIdOnSrcChain=40161

# Config for IOTA MoveVM testnet (dest chain)
lzEndpointOnDestChain=0x1a44076050125825900e736c501f859c50fE728c
#### This is EID of IOTA MoveVM testnet
lzEndpointIdOnDestChain=40423

# For deployment of OFTAdapter on source chain (IotaEVM)
erc20TokenAddress="0x514b0C11Bd143778367f1d1273ba1b2236Fb383c"

#### Solidity OFTAdapter contract on EVM as src chain
oftAdapterContractAddress="0x0003d9Ce49871F984268f7eCaFb8026aa7be4Ee3"

#### Solidity OFT contract on EVM as dest chain
oftContractAddress="0xE03934D55A6d0f2Dc20759A1317c9Dd8f9D683cA"

#### OFT on IOTA MoveVM testnet is the "oftPackageId" (instead of "oftObjectId")
####### for newly-deployed OFT packageID, must run setPeer again
oftPackageId=0xa947ff8022f37c32b06a67d674154f170422e0c95cf44e1a55f3c2a45fa355f2

# For setEnforcedOptions
# https://docs.layerzero.network/v2/developers/evm/gas-settings/options#lzreceive-option
executorLzReceiveOptionMaxGas=200000

# For sending the origin erc20 tokens
# On some chains, if setting this gasDrop on destination, the cross-chain sending tx can get failed with error "execution reverted"
gasDropInWeiOnDestChain=0
# iota-1
SENDER_ACCOUNT_PRIV_KEY="put here your own private key"
# iota-OFT-deploy
RECEIVER_ACCOUNT_ADDRESS=0xd3906909a7bfc50ea9f4c0772a75bc99cd0da938c90ec05a556de1b5407bd639
# Token amount to send
AMOUNT=3
